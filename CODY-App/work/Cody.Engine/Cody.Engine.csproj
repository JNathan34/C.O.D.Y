<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HeyClicky</AssemblyName>
    <OutputType>WinExe</OutputType>
    <StartupObject>HeyClicky.App.Program</StartupObject>
    <UseAppHost>false</UseAppHost>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sherpa-onnx"><HintPath>../wake-dotnet/managed/lib/net8.0/sherpa-onnx.dll</HintPath></Reference>
    <Content Include="../wake-dotnet/runtime/runtimes/win-x64/native/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BundledResources/wake/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.InteractiveExperiences.Projection">
      <HintPath>../../pristine/windows-1.1.3/Microsoft.InteractiveExperiences.Projection.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.WinUI">
      <HintPath>../../pristine/windows-1.1.3/Microsoft.WinUI.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>../../pristine/windows-1.1.3/WinRT.Runtime.dll</HintPath>
    </Reference>
    <ProjectReference Include="../Cody.Core/Cody.Core.csproj" />
    <Reference Include="HeyClicky.Contracts">
      <HintPath>../../pristine/windows-1.1.3/HeyClicky.Contracts.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>../../pristine/windows-1.1.3/Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="HeyClicky.Agents">
      <HintPath>../../pristine/windows-1.1.3/HeyClicky.Agents.dll</HintPath>
    </Reference>
    <Reference Include="HeyClicky.Drawing">
      <HintPath>../../pristine/windows-1.1.3/HeyClicky.Drawing.dll</HintPath>
    </Reference>
    <Reference Include="HeyClicky.Platform">
      <HintPath>../../pristine/windows-1.1.3/HeyClicky.Platform.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Graphics.Canvas.Interop">
      <HintPath>../../pristine/windows-1.1.3/Microsoft.Graphics.Canvas.Interop.dll</HintPath>
    </Reference>
    <Reference Include="Sentry">
      <HintPath>../../pristine/windows-1.1.3/Sentry.dll</HintPath>
